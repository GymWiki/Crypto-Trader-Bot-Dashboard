# The only backend fact this app knows: where the control-plane API lives.
# This repo has no other knowledge of how or where that backend is hosted — see ARCHITECTURE.md.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project used for auth. Must be the SAME project the backend verifies
# JWTs against (its SUPABASE_JWT_SECRET), or every authenticated call will 401 —
# this mismatch is exactly what /setup check #3 (Backend <-> Supabase link) detects.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
