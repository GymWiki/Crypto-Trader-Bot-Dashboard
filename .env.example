# The only backend fact this app knows: where the control-plane API lives.
# This repo has no other knowledge of how or where that backend is hosted — see ARCHITECTURE.md.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Neon Auth (Managed Better Auth) used for auth. Must be the SAME Neon Auth project the backend
# verifies JWTs against (its NEON_AUTH_BASE_URL), or every authenticated call will 401 — this
# mismatch is exactly what /setup check #3 (Backend <-> Neon Auth link) detects.
# Get this from the Neon Console's Auth page. Origin follows the pattern:
# https://ep-xxx.neonauth.<region>.aws.neon.build/<dbname>/auth
# This repo uses plain better-auth's client pointed at this URL (not Neon's own
# @neondatabase/auth package, which requires Next.js 16+ — see ARCHITECTURE.md).
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-xxx.neonauth.example.aws.neon.build/yourdb/auth
